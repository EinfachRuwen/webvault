{
  "name": "webvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cryptomator-Tresore komplett im Browser öffnen, durchsuchen, ent- und verschlüsseln – ohne Backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/ui.mjs && node tests/e2e/fallback.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
